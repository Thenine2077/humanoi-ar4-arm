<?xml version="1.0"?>
<package format="3">
  <name>ar_mirror</name>
  <version>0.1.0</version>
  <description>
    Drives the real AR4 arm (ar_hardware_interface) and the simulated arm
    (ar_gz_bringup) at the same time, mirroring the sim's /joint_states onto
    the real arm's joint_trajectory_controller so both move together when
    commanded from MoveIt against the sim.
  </description>
  <license>MIT</license>
  <maintainer email="sale2@eitlaser.com">User</maintainer>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>ar_description</exec_depend>
  <exec_depend>ar_hardware_interface</exec_depend>
  <exec_depend>ar_gz_bringup</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
