<?xml version="1.0"?>
<!-- Gazebo Harmonic (gz-sim) version of the vendor's ar_gazebo.urdf.xacro.
     Reuses ar_description's ar_macro.xacro (links/joints/meshes) and
     ar.ros2_control.xacro (joint limits + ros2_control block) UNMODIFIED via
     xacro:include — only the simulation plugin differs: gz_ros2_control
     (Harmonic) instead of gazebo_ros2_control (Classic, not available on
     ROS 2 Jazzy). See docs in Humanoi's ar4-robot-arm-vendor memory. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:include filename="$(find ar_description)/urdf/ar_macro.xacro"/>
  <xacro:include filename="$(find ar_description)/urdf/ar.ros2_control.xacro"/>

  <xacro:arg name="name" default="ar"/>
  <xacro:arg name="simulation_controllers" default=""/>

  <link name="world"/>
  <xacro:ar_robot parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ar_robot>

  <!-- Write <ros2_control> here instead of calling the vendor's xacro:ar_ros2_control, because
       ar.ros2_control.xacro has 2 things that don't work in sim (read only, that file is not edited):
       1) limits are written as "{-170*pi/180}" without the leading "$" (needs "${...}" for xacro
          to evaluate it), so it stays raw text that gz_ros2_control can't parse as a number (log:
          "Error parsing the limits...Skipping it") — below they are computed directly in radians
       2) position_proportional_gain is not set at all, so gz_ros2_control uses the default 0.1,
          which is too weak to hold against gravity; the arm slowly sags to its hard stop within a few tens of seconds
          (the real reason CheckStartStateBounds kept failing on joint_3/joint_5) -->
  <ros2_control name="$(arg name)" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="serial_port">None</param>
      <param name="calibrate">False</param>
      <!-- gz_ros2_control reads this gain at the <hardware> level (not per joint) and uses it
           to compute velocity command = gain * (target - actual); the default 0.1 is too slow -->
      <param name="position_proportional_gain">20.0</param>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-2.967060</param>
        <param name="max">2.967060</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-0.733038</param>
        <param name="max">1.570796</param>
      </command_interface>
      <state_interface name="position">
        <!-- Set to match the real arm's actual "rest pose" after calibrate (measured -5.84 degrees = -0.1019 rad
             from the ar_hardware_interface log, 2026-09-17) so the sim and the real arm start in the same
             pose — otherwise, when mirroring starts, the real arm is told to jump to 0 degrees at once -->
        <param name="initial_value">-0.1019</param>
      </state_interface>
    </joint>
    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-1.553343</param>
        <param name="max">0.907571</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-2.879793</param>
        <param name="max">2.879793</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">-1.832596</param>
        <param name="max">1.832596</param>
      </command_interface>
      <state_interface name="position">
        <!-- The real arm's rest pose after calibrate = -52.16 degrees = -0.9103 rad (same reason as joint_2) -->
        <param name="initial_value">-0.9103</param>
      </state_interface>
    </joint>
    <joint name="joint_6">
      <command_interface name="position">
        <param name="min">-2.705260</param>
        <param name="max">2.705260</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>

  <gazebo reference="world"/>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
    </plugin>
  </gazebo>
</robot>
