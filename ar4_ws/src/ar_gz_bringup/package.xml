<?xml version="1.0"?>
<package format="3">
  <name>ar_gz_bringup</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic (gz-sim) simulation bring-up for the AR4 arm, built on top of
    the vendor-supplied ar_description / ar_hardware_interface / ar_moveit_config
    packages (unmodified). Replaces the vendor's Gazebo Classic ar_gazebo package,
    which is not available on ROS 2 Jazzy.
  </description>
  <license>MIT</license>
  <maintainer email="sale2@eitlaser.com">User</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ar_description</exec_depend>
  <exec_depend>ar_hardware_interface</exec_depend>
  <exec_depend>ar_moveit_config</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
