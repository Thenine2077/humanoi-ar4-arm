<?xml version="1.0"?>
<!-- Humanoi upper body: pole + head + camera + two AR4 arms + hands — one file used by both the real arm system
  (humanoi_arms.urdf.xacro) and the full robot in Gazebo (humanoi_description/urdf/humanoi_full.urdf.xacro)
  Change dimensions only in this file, so RViz/MoveIt for the real arms and the sim always match

  Frame "torso" = midpoint between the two arm bases, at shoulder height: X to the robot's front, Y to the robot's left, Z up
  Arm base (AR4 base_link: Z = J1 axis pointing out of the mounting surface) is fixed to the horizontal pole
  - Left: Z points to the robot's left, X forward, Y down — from the hand-eye calibration on 15 Oct (up = base -Y)
  - Right: reversed from the left (J1 motor box hangs down the same way, per the photo) — Z points right, X backward, Y down
    ** guessed from a photo, not measured — if the right arm model in RViz doesn't match the real arm, fix up_right_rpy **
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find ar_dual)/urdf/ar_arm.xacro"/>
  <xacro:include filename="$(find ar_dual)/urdf/amazinghand.xacro"/>

  <!-- ===== Measured on the real robot 19 Oct 2026 (heights from the floor) ===== -->
  <xacro:property name="up_shoulder_z" value="1.455"/>   <!-- H: floor -> center of arm base (J1 axis) -->
  <xacro:property name="up_plate_top" value="0.205"/>    <!-- C + B: floor -> top of base plate (19.5 + 1 cm) -->
  <xacro:property name="up_head_top" value="1.77"/>      <!-- I: floor -> top of head -->
  <xacro:property name="up_half_gap" value="0.055"/>     <!-- left and right arm bases are 11 cm apart -->
  <!-- ===== Not measured yet (estimated from photos) ===== -->
  <xacro:property name="up_pole_x" value="0.10"/>        <!-- pole cross-section, front-back -->
  <xacro:property name="up_pole_y" value="0.08"/>        <!-- pole cross-section, left-right -->
  <xacro:property name="up_pole_dx" value="0.01"/>       <!-- pole center is in front of the shoulder axis -->
  <xacro:property name="up_head_r" value="0.13"/>        <!-- helmet, approximated as a sphere -->

  <!-- ===== Computed from the values above (relative to the torso frame) ===== -->
  <xacro:property name="up_pole_bottom" value="${up_plate_top - up_shoulder_z}"/>
  <xacro:property name="up_head_cz" value="${up_head_top - up_shoulder_z - up_head_r}"/>
  <xacro:property name="up_pole_len" value="${up_head_cz - up_pole_bottom}"/>
  <xacro:property name="up_pole_cz" value="${(up_head_cz + up_pole_bottom) / 2}"/>
  <xacro:property name="up_left_rpy" value="${-pi/2} 0 0"/>
  <xacro:property name="up_right_rpy" value="${-pi/2} 0 ${pi}"/>

  <!-- left_hand / right_hand: whether that arm has an AmazingHand -->
  <xacro:macro name="humanoi_upper" params="left_hand:=true right_hand:=true">
    <link name="torso">
      <!-- aluminium profile pole, from the top of the base plate up to the head -->
      <visual>
        <origin xyz="${up_pole_dx} 0 ${up_pole_cz}" rpy="0 0 0"/>
        <geometry><box size="${up_pole_x} ${up_pole_y} ${up_pole_len}"/></geometry>
        <material name="pole"><color rgba="0.75 0.75 0.78 1"/></material>
      </visual>
      <collision>
        <origin xyz="${up_pole_dx} 0 ${up_pole_cz}" rpy="0 0 0"/>
        <geometry><box size="${up_pole_x} ${up_pole_y} ${up_pole_len}"/></geometry>
      </collision>
      <!-- head (helmet) -->
      <visual>
        <origin xyz="0.02 0 ${up_head_cz}" rpy="0 0 0"/>
        <geometry><sphere radius="${up_head_r}"/></geometry>
        <material name="head"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.02 0 ${up_head_cz}" rpy="0 0 0"/>
        <geometry><sphere radius="${up_head_r}"/></geometry>
      </collision>
      <!-- Astra Pro camera on the front of the pole below the shoulders (position from hand-eye) -->
      <visual>
        <origin xyz="0.095 0.009 -0.048" rpy="0 0 0"/>
        <geometry><box size="0.05 0.17 0.05"/></geometry>
        <material name="camera"><color rgba="0.2 0.2 0.25 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.095 0.009 -0.048" rpy="0 0 0"/>
        <geometry><box size="0.05 0.17 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${up_pole_dx} 0 ${up_pole_cz}" rpy="0 0 0"/>
        <mass value="3.0"/>
        <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.01"/>
      </inertial>
    </link>

    <!-- Left arm: real joint zero (off in degrees = real angle − angle the program reports) — 26 Oct the user leveled each joint with a spirit level
         (real angle 0) and read the program values: joint 1 7 · joint 2 2 · joint 3 0 · joint 4 7 · joint 5 −19 · joint 6 −15 -> off = −value read
         (if a joint looks more crooked in the model than before = flip that joint's sign)
         All joints have moved to the board's zero trim (config/zero_trims.yaml -> program values = real angles), so off is 0 on every joint
         Joints moved to the board: that joint's off = 0 (otherwise it is compensated twice) — off is only for joints not yet moved -->
    <xacro:ar_arm prefix="left_" parent="torso" off1="0" off2="0" off3="0" off4="0" off5="0" off6="0">
      <origin xyz="0 ${up_half_gap} 0" rpy="${up_left_rpy}"/>
    </xacro:ar_arm>
    <!-- Right arm: joint 4 zero is 180° from the original model (flip4) + joint 5 reversed (dir5)
         21 Oct the user saw the joint 5 assembly on the wrong side and the flange pointing at the pole (previously only dir5="-1" since 16 Oct)
         Checked at the rest pose after calibrate (both arms same joint values) against the mirror image of the left arm:
           dir5 only           → flange points at the pole, joint 4 part off by 34 mm
           flip4 + dir5        → flange correct, joint 4/5/6 parts off by ~14 mm (same as other parts — the two arms' parts are not left/right mirrored)
         If another joint turns out reversed, add dirN="-1" here -->
    <xacro:ar_arm prefix="right_" parent="torso" dir5="-1" flip4="1">
      <origin xyz="0 ${-up_half_gap} 0" rpy="${up_right_rpy}"/>
    </xacro:ar_arm>

    <xacro:if value="${left_hand}">
      <!-- Compared with a photo of the rest pose after calibrate (21 Oct): palm faces the pole/up = 90° rotation from the model
           white round mount between flange and hand ~25 mm (estimated from photo — measure and fix mount_offset)
           26 Oct: left arm switched to the left-hand set (arm hand-side left) — photo: palm faces the same way, thumb on the outside
           while in the model (right hand) the thumb is on the pole side -> use the left-hand mesh, same mount angle -->
      <xacro:amazinghand prefix="left_" parent="left_link_6" side="left" mount_offset="0.025" mount_yaw="${pi/2}"/>
    </xacro:if>
    <xacro:if value="${right_hand}">
      <!-- The right-hand set goes on the right arm (mirror image of the left arm) — mount_yaw mirrors the left arm's
           (no photo of the real hand on the right arm yet — compare again once there is one) -->
      <xacro:amazinghand prefix="right_" parent="right_link_6" side="right" mount_offset="0.025"
                         mount_yaw="${-pi/2}"/>
    </xacro:if>
  </xacro:macro>
</robot>
