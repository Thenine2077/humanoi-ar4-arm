<?xml version="1.0"?>
<!-- ros2_control for one AR4 arm (joint names ${prefix}joint_1..6) — shared by the real arm and the sim
  hw = real (Teensy via the vendor driver) | mock (simulated, no board) | gz (Gazebo via gz_ros2_control)
       | none (no ros2_control for this arm — one controller per arm, each loads only its own arm)
  Limits are literal numbers (the vendor file writes {..} without $, so it fails to parse)
  initial_value = rest pose after calibrate (used for mock / sim)
  Limits / rest pose = vendor values + that arm's zero trim stored in the board (config/zero_trims.yaml)
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="arm_joint" params="name lo hi init">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lo * pi / 180}</param>
        <param name="max">${hi * pi / 180}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${init}</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="arm_control" params="prefix hw port:=none">
    <!-- This arm's zero trim stored in the board (ar_dual/config/zero_trims.yaml) — limits and rest pose shift with it -->
    <xacro:property name="zcfg" value="${xacro.load_yaml('$(find ar_dual)/config/zero_trims.yaml')}"/>
    <xacro:property name="zt" value="${[float(v) for v in zcfg.get(prefix[:-1], [0] * 6)]}"/>
    <!-- After-calibration pose (after_calibrate, real angle in degrees) replaces the firmware rest pose for the listed joints -->
    <xacro:property name="ac" value="${dict((int(k), float(v)) for k, v in ((zcfg.get('after_calibrate') or dict()).get(prefix[:-1]) or dict()).items())}"/>
    <xacro:unless value="${hw == 'none'}">
    <ros2_control name="${prefix}arm" type="system">
      <hardware>
        <xacro:if value="${hw == 'real'}">
          <plugin>ar_hardware_interface/ARHardwareInterface</plugin>
          <param name="serial_port">${port}</param>
          <param name="calibrate">False</param>
        </xacro:if>
        <xacro:if value="${hw == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${hw == 'gz'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
          <!-- default 0.1 is too weak to hold the arm's weight, the arm slowly sags (seen in the single-arm sim) -->
          <param name="position_proportional_gain">20.0</param>
        </xacro:if>
      </hardware>
      <xacro:arm_joint name="${prefix}joint_1" lo="${-170 + zt[0]}" hi="${170 + zt[0]}" init="${ac[1] * pi / 180 if 1 in ac else 0.0 + zt[0] * pi / 180}"/>
      <xacro:arm_joint name="${prefix}joint_2" lo="${-42 + zt[1]}" hi="${90 + zt[1]}" init="${ac[2] * pi / 180 if 2 in ac else -0.1019 + zt[1] * pi / 180}"/>
      <xacro:arm_joint name="${prefix}joint_3" lo="${-89 + zt[2]}" hi="${52 + zt[2]}" init="${ac[3] * pi / 180 if 3 in ac else 0.0 + zt[2] * pi / 180}"/>
      <xacro:arm_joint name="${prefix}joint_4" lo="${-165 + zt[3]}" hi="${165 + zt[3]}" init="${ac[4] * pi / 180 if 4 in ac else 0.0 + zt[3] * pi / 180}"/>
      <xacro:arm_joint name="${prefix}joint_5" lo="${-105 + zt[4]}" hi="${105 + zt[4]}" init="${ac[5] * pi / 180 if 5 in ac else -0.9103 + zt[4] * pi / 180}"/>
      <xacro:arm_joint name="${prefix}joint_6" lo="${-155 + zt[5]}" hi="${155 + zt[5]}" init="${ac[6] * pi / 180 if 6 in ac else 0.0 + zt[5] * pi / 180}"/>
    </ros2_control>
    </xacro:unless>
  </xacro:macro>
</robot>
