<?xml version="1.0"?>
<!-- Humanoi: แขน AR4 สองตัว (ซ้าย/ขวา) ติดสองข้างเสากลาง + เสา หัว กล้อง มือ — สำหรับระบบแขนจริง (ไม่มีฐานล้อ)
  เรขาคณิตทั้งหมดอยู่ใน humanoi_upper.xacro (ใช้ร่วมกับหุ่นเต็มตัวใน Gazebo) — แก้ขนาดที่นั่น

  ฮาร์ดแวร์แต่ละแขน: left_hw / right_hw = real (Teensy ผ่านไดรเวอร์ของผู้ขาย) หรือ mock (จำลอง ไม่ต่อบอร์ด)
  calibrate ไม่ทำใน ROS (ไดรเวอร์ผู้ขายบล็อก ~2 นาที/แขน และ USB มักหลุดระหว่างนั้น) — ใช้ scripts/ar_calibrate.py
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="humanoi_arms">
  <xacro:arg name="left_port" default="/dev/serial/by-path/platform-xhci-hcd.0-usb-0:1:1.0"/>
  <xacro:arg name="right_port" default="/dev/serial/by-path/platform-xhci-hcd.1-usb-0:2:1.0"/>
  <xacro:arg name="left_hw" default="real"/>
  <xacro:arg name="right_hw" default="real"/>

  <xacro:include filename="$(find ar_dual)/urdf/humanoi_upper.xacro"/>
  <xacro:include filename="$(find ar_dual)/urdf/arm_control.xacro"/>

  <xacro:humanoi_upper/>
  <xacro:arm_control prefix="left_" hw="$(arg left_hw)" port="$(arg left_port)"/>
  <xacro:arm_control prefix="right_" hw="$(arg right_hw)" port="$(arg right_port)"/>
</robot>
