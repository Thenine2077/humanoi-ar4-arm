<?xml version="1.0"?>
<!-- AmazingHand (Pollen Robotics, 8 SCS0009 servos) mounted on the joint 6 flange of an AR4 arm
  side = right (maker's mesh) | left (right mesh mirrored across Y — ah_left_*.stl, see NOTICE.md)

  Geometry from the maker's 3D model (meshes/amazinghand — see NOTICE.md), fingers fixed in the CAD default pose
  (fingers slightly bent) — fingers cannot move in the model yet · collision is 3 boxes enclosing the mesh (wrist / palm+thumb / fingers)

  Frame ${prefix}hand: Z = from the wrist mount face (z = 0) toward the fingertips (along joint 6 axis), +X = palm side
  The link_6 flange is at z = 0.016 (top edge of ar_description/meshes/ar4/link_6.STL)

  Not measured yet (set when calling the macro):
    mount_offset = thickness of the mount from the flange to the hand's wrist mount face (m)
    mount_yaw    = angle the hand is rotated about the joint 6 axis relative to the model (rad) — check from a photo with joint 6 = 0
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="amazinghand" params="prefix parent side:=right mount_offset:=0.0 mount_yaw:=0.0">
    <xacro:property name="ys" value="${1 if side == 'right' else -1}"/>
    <joint name="${prefix}hand_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}hand"/>
      <origin xyz="0 0 ${0.016 + mount_offset}" rpy="0 0 ${mount_yaw}"/>
    </joint>

    <link name="${prefix}hand">
      <!-- servos + palm plate (dark) -->
      <visual>
        <geometry>
          <mesh filename="file://$(find ar_dual)/meshes/amazinghand/ah_${side}_dark.stl"/>
        </geometry>
        <material name="hand_dark"><color rgba="0.28 0.29 0.31 1"/></material>
      </visual>
      <!-- 3D-printed frame + finger shells (light) -->
      <visual>
        <geometry>
          <mesh filename="file://$(find ar_dual)/meshes/amazinghand/ah_${side}_light.stl"/>
        </geometry>
        <material name="hand_light"><color rgba="0.92 0.92 0.92 1"/></material>
      </visual>
      <!-- wrist / mount -->
      <collision>
        <origin xyz="0.012 ${ys * 0.002} 0.0156" rpy="0 0 0"/>
        <geometry><box size="0.079 0.076 0.029"/></geometry>
      </collision>
      <!-- palm + servos + thumb -->
      <collision>
        <origin xyz="0.030 0 0.065" rpy="0 0 0"/>
        <geometry><box size="0.125 0.111 0.070"/></geometry>
      </collision>
      <!-- index, middle, ring fingers -->
      <collision>
        <origin xyz="0.013 ${ys * -0.014} 0.135" rpy="0 0 0"/>
        <geometry><box size="0.081 0.103 0.070"/></geometry>
      </collision>
      <!-- ~400 g whole hand (8 servos + 3D-printed frame) -->
      <inertial>
        <origin xyz="0.02 0 0.07" rpy="0 0 0"/>
        <mass value="0.4"/>
        <inertia ixx="0.0011" ixy="0" ixz="0" iyy="0.0011" iyz="0" izz="0.0005"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>
